# ============================================
# ETSY INTEGRATION CONFIGURATION
# ============================================

# Etsy App Keystring (API Key)
# გამოიყენება როგორც x-api-key ჰედერად, ასევე OAuth client_id-დ
# წყარო: etsy.com/developers → Your Apps → App → Keystring
ETSY_KEYSTRING=your_keystring_here

# Etsy Shared Secret (აუცილებელია!)
# Etsy API ითხოვს x-api-key ჰედერს ფორმატით "keystring:shared_secret" —
# ამის გარეშე მოთხოვნები ბრუნდება 403-ით
ETSY_SHARED_SECRET=your_shared_secret_here

# OAuth Callback URL
# ზუსტად უნდა ემთხვეოდეს Etsy app-ში რეგისტრირებულ Callback URL-ს!
# Etsy Developers → Your Apps → App → Manage → Callback URLs
# შენიშვნა: სერვერს აქვს გლობალური /v1 პრეფიქსი (URI versioning)
# ლოკალურად: http://localhost:4000/v1/etsy/oauth/callback
ETSY_REDIRECT_URI=https://api.soulart.ge/v1/etsy/oauth/callback

# ============================================
# როგორ მუშაობს:
# ============================================
#
# 1. დაამატეთ ზემოთ მოცემული ცვლადები .env ფაილში
# 2. შეამოწმეთ keystring: GET /etsy/ping (admin token-ით)
# 3. მიიღეთ ავტორიზაციის ლინკი: GET /etsy/auth (admin token-ით)
# 4. გახსენით ლინკი ბრაუზერში, სადაც SoulArt-ის Etsy ანგარიშით
#    ხართ შესული და დაადასტურეთ წვდომა
# 5. Etsy დაგაბრუნებთ callback-ზე — ტოკენები ავტომატურად
#    შეინახება ბაზაში (refresh token-ს Etsy ყოველ განახლებაზე
#    ცვლის, ამიტომ ის .env-ში არ ინახება)
# 6. სტატუსის შემოწმება: GET /etsy/status
#
# App Name-ის env ცვლადი არ სჭირდება — ის მხოლოდ Etsy-ს
# dashboard-ზე გამოსაჩენი სახელია.
#
# ============================================
